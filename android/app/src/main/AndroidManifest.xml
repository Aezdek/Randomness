<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Live location in a chat, only while it is being shared and Hush is open. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 14+: tells a protected chat when a screenshot got through (see ui/messages/Chat.kt). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: an app updating itself can skip the "Update?" prompt once it installed the current build. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".HushApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hush.Starting"
        tools:targetApi="34">

        <activity
            android:name=".HushActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- The home screen icon, as an alias so Hush can wear another one instead (below). It keeps the activity's
             old name, so icons people already placed on their home screens keep working. -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".HushActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The disguise (see disguise/Disguise.kt). Its icons open the "keeps stopping" screen, which is see-through
             and has a task of its own that stays out of the recent apps list. Exported only so its aliases can be;
             it trusts nothing a caller puts in its intent but where to go once you are in. -->
        <activity
            android:name=".disguise.DecoyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=":decoy"
            android:theme="@style/Theme.Hush.Decoy"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".DisguiseVideos"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_videos"
            android:roundIcon="@mipmap/ic_disguise_videos"
            android:label="Videos"
            android:targetActivity=".disguise.DecoyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_calculator"
            android:roundIcon="@mipmap/ic_disguise_calculator"
            android:label="Calculator"
            android:targetActivity=".disguise.DecoyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseWeather"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_weather"
            android:roundIcon="@mipmap/ic_disguise_weather"
            android:label="Weather"
            android:targetActivity=".disguise.DecoyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_notes"
            android:roundIcon="@mipmap/ic_disguise_notes"
            android:label="Notes"
            android:targetActivity=".disguise.DecoyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- No picture and no name: the label is U+2800, a blank that launchers don't trim away to "Hush". -->
        <activity-alias
            android:name=".DisguiseBlank"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_blank"
            android:roundIcon="@mipmap/ic_disguise_blank"
            android:label="@string/disguise_blank_label"
            android:targetActivity=".disguise.DecoyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".calls.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Hush" />

        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <service
            android:name=".calls.CallService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A quick settings tile that takes the account off this phone at once (see Wipe.kt). Its name says nothing
             about Hush; it is only there for people who add it. -->
        <service
            android:name=".service.PanicTile"
            android:exported="true"
            android:icon="@drawable/disguise_blank_small"
            android:label="Quick clear"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".calls.CallActionReceiver"
            android:exported="false" />

        <!-- "That was me" and "Not me" on the new sign-in notification (see service/SecurityWatch.kt). -->
        <receiver
            android:name=".service.SecurityActionReceiver"
            android:exported="false" />

        <!-- Android reports how an app update install went here (see update/AutoUpdater.kt). -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
